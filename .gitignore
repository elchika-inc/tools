# Dependencies
node_modules/
apps/*/node_modules/

# Build output
dist/
build/
.wrangler/
apps/*/.wrangler/
apps/*/dist/
apps/*/build/

# Environment variables
.env
.env.local
.env.*.local
.dev.vars
apps/*/.dev.vars

# Package manager lock files (using bun, ignore others)
package-lock.json
yarn.lock
apps/*/package-lock.json
apps/*/yarn.lock

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# IDE
.vscode/
.cursor/
.cursorignore
.cursorrules
.kiro/

# Coding Agent
.claude/
.claude.local.md


# Temporary files
*.tmp
*.temp
.cache/

# Backup files
*.backup

# Playwright MCP temporary files
.playwright-mcp/

# 検証スクショはリポルート直下に出力されがちなので無視する
# (サブディレクトリの画像は対象外。ルート直下だけを狙う)
/*.png

# Playwright
test-results/
playwright-report/
playwright/.cache/

apps/*/public/fonts
